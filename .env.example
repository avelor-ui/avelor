# Public site origin, used for the install command and the registry fetch event.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Umami Cloud website id (a public identifier, not a secret). Unset in dev, CI
# and preview deployments: page views and registry_fetch events are then off.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Only for the analytics-failure test: point the event gateway at an
# unreachable host and confirm /r/<name>.json still returns 200.
# UMAMI_GATEWAY_URL=http://127.0.0.1:9/api/send
